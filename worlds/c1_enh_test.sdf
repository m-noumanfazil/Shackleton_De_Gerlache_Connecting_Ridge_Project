<?xml version="1.0" ?>
<sdf version="1.8">
  <world name="c1_enh_test">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="ignition-gazebo-physics-system"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="ignition-gazebo-user-commands-system"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="ignition-gazebo-scene-broadcaster-system"
            name="ignition::gazebo::systems::SceneBroadcaster"/>

    <!-- Lunar gravity -->
    <gravity>0 0 -1.62</gravity>
    
    <gui fullscreen="0">
    <plugin filename="MinimalScene" name="3D View">
    <ignition-gui>
      <title>3D View</title>
      <property type="bool" key="showTitleBar">false</property>
      <property type="string" key="state">docked</property>
    </ignition-gui>
    <engine>ogre2</engine>
    <scene>scene</scene>
    <ambient_light>0.35 0.35 0.35</ambient_light>
    <background_color>0 0 0</background_color>
    <camera_pose>-150 -150 80 0 0.45 0.78</camera_pose>
    </plugin>
    <plugin filename="GzSceneManager" name="Scene Manager"/>
    <plugin filename="InteractiveViewControl" name="Interactive view control"/>
    <plugin filename="EntityTree" name="Entity tree"/>
    </gui>
  
    <!-- Black sky, TEST ambient (lower to ~0.03 for final lunar look) -->
    <scene>
      <background>0 0 0 1</background>
      <ambient>0.35 0.35 0.35 1</ambient>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>

    <!-- Key light: ~25 deg elevation, gives relief + shadows.
         FINAL lunar value: direction -0.996195 0 -0.087156 (5 deg) -->
    <light type="directional" name="sun_key">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>1.0 1.0 1.0 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <direction>0.7 0.3 -0.35</direction>
    </light>

    <!-- Fill light: TEMPORARY, remove for the final lunar look -->
    <light type="directional" name="sun_fill">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.35 0.35 0.35 1</diffuse>
      <specular>0 0 0 1</specular>
      <direction>0 0 -1</direction>
    </light>

    <!-- Terrain -->
    <include>
      <uri>model://c1_terrain_enh</uri>
    </include>

    <!-- Collision test box -->
    <model name="test_box">
      <pose>0 0 12.98 0 0 0</pose>
      <link name="box_link">
        <inertial>
          <mass>5.0</mass>
          <inertia>
            <ixx>0.208333</ixx><ixy>0</ixy><ixz>0</ixz>
            <iyy>0.208333</iyy><iyz>0</iyz>
            <izz>0.208333</izz>
          </inertia>
        </inertial>
        <collision name="box_collision">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
        </collision>
        <visual name="box_visual">
          <geometry><box><size>0.5 0.5 0.5</size></box></geometry>
          <material>
            <ambient>0.8 0.2 0.2 1</ambient>
            <diffuse>0.8 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
